# Email for Let's Encrypt certificate notices (not shown on the site)
ACME_EMAIL=hello@basednotes.app

# BSD-553: folder with the beta DMG on this server (rsync target of the Desktop Beta workflow)
# BETA_HOST_DIR=/srv/based-beta

# BSD-631: token for the read-only numbers (GET /api/waitlist/stats and /api/waitlist/check?email=…).
# Create one with `openssl rand -hex 24`. Empty or missing: both answer 404.
# WAITLIST_STATS_TOKEN=
