<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opt-in "local agents" variant (BASED_AGENTS_SUFFIX = -Agents in Config/Local.xcconfig).
	     Without the App Sandbox so Claude Code / Codex / npx can run with the user's login-shell PATH,
	     ~/.claude credentials and project folders. Hardened runtime stays on. The default build keeps
	     the sandbox; there, agents run through a Based server instead. -->
	<key>com.apple.security.network.client</key><true/>
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<key>com.apple.developer.aps-environment</key><string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key><array><string>$(BASED_CLOUDKIT_CONTAINER)</string></array>
	<key>com.apple.developer.icloud-services</key><array><string>CloudKit</string></array>
	<key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
