{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Based Next",
  "version": "0.1.0",
  "identifier": "com.friedrich-ulrich.based.next",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @based/desktop sidecar && pnpm --filter @based/web dev",
    "beforeBuildCommand": "pnpm --filter @based/desktop sidecar && pnpm --filter @based/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Based Next",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../dist-sidecar/based-server.cjs": "based-server.cjs"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQTU3NkVBOTUxMDRBQjgKUldTNFNoQ1Y2bmFsWVNuWTNTY3J0RWdjMUhVSUJRQ3JvNHZScFZnMW5PZG9NRkRBdTNlZGRSbFMK",
      "endpoints": [
        "https://github.com/elija-7580/Based/releases/download/next-latest/latest.json"
      ]
    }
  }
}
