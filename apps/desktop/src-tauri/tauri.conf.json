{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Based",
  "version": "0.0.0",
  "identifier": "com.friedrichulrich.based",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @based/web dev",
    "beforeBuildCommand": "pnpm --filter @based/web build"
  },
  "app": {
    "windows": [{ "title": "Based", "width": 1200, "height": 800 }]
  },
  "bundle": { "active": true, "targets": ["dmg", "app"] }
}
