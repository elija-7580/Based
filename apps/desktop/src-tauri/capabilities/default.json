{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte der Fenster (Haupt- und Seitenfenster): Kern, Fenster ziehen (Titelleiste), Fenster schließen/ausblenden (⌘W beim letzten Tab, BSD-310), Seitenfenster öffnen, Menü, Updater, Rückfrage-Dialog, Neustart nach dem Update, HTTP nur zu Notion (API-Import, BSD-217: API und von Notion gehostete Dateien). BSD-319: Dateien nur in ~/.config/based/reports (Fehlerberichte) lesen, schreiben, löschen; Bericht im Finder zeigen.",
  "windows": [
    "main",
    "page-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:webview:allow-create-webview-window",
    "core:menu:default",
    "updater:default",
    "dialog:allow-ask",
    "dialog:allow-message",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.notion.com/*"
        },
        {
          "url": "https://*.notion.so/*"
        },
        {
          "url": "https://*.notion.com/*"
        },
        {
          "url": "https://*.notionusercontent.com/*"
        },
        {
          "url": "https://*.notion-static.com/*"
        },
        {
          "url": "https://*.amazonaws.com/*"
        },
        {
          "url": "https://*/*"
        }
      ]
    },
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/.config/based/reports"
        },
        {
          "path": "$HOME/.config/based/reports/**"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
