{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte der Fenster (Haupt- und Seitenfenster): Kern, Fenster ziehen (Titelleiste), Fenster schließen/ausblenden (⌘W beim letzten Tab, BSD-310), Seitenfenster öffnen, Menü, Updater, Rückfrage-Dialog, Neustart nach dem Update, HTTP nur zu Notion (API-Import, BSD-217: API und von Notion gehostete Dateien).",
  "windows": [
    "main",
    "page-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:webview:allow-create-webview-window",
    "core:menu:default",
    "updater:default",
    "dialog:allow-ask",
    "dialog:allow-message",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.notion.com/*"
        },
        {
          "url": "https://*.notion.so/*"
        },
        {
          "url": "https://*.notion.com/*"
        },
        {
          "url": "https://*.notionusercontent.com/*"
        },
        {
          "url": "https://*.notion-static.com/*"
        },
        {
          "url": "https://*.amazonaws.com/*"
        }
      ]
    }
  ]
}
