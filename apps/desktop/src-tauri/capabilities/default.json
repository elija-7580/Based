{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rechte des Hauptfensters: Kern, Fenster ziehen (Titelleiste), Menü, Updater, Rückfrage-Dialog, Neustart nach dem Update.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:menu:default",
    "updater:default",
    "dialog:allow-ask",
    "dialog:allow-message",
    "process:allow-restart"
  ]
}
