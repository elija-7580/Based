{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Based",
  "version": "0.1.0",
  "identifier": "com.friedrich-ulrich.based.next",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @based/web dev",
    "beforeBuildCommand": "pnpm --filter @based/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Based"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "copyright": "Based Notes © 2026 Elija Samuel Friedrich-Ulrich. Licensed under AGPL-3.0-or-later.",
    "active": true,
    "category": "Productivity",
    "icon": [
      "../../desktop/src-tauri/icons/32x32.png",
      "../../desktop/src-tauri/icons/128x128.png",
      "../../desktop/src-tauri/icons/128x128@2x.png",
      "../../desktop/src-tauri/icons/icon.icns",
      "../../desktop/src-tauri/icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  }
}
